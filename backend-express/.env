# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# ⚠️  IMPORTANT: Replace <cluster-id> below with the actual 5-char code from your
# Atlas dashboard connection string (e.g., abc12). Go to: Atlas → Connect → Drivers
# Example: mongodb+srv://suhasbhat1204_db_user:rv1hp4jEbgjz1jYL@cluster0.abc12.mongodb.net/ai_stock?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://suhasbhat1204_db_user:rv1hp4jEbgjz1jYL@cluster0.REPLACE_THIS.mongodb.net/ai_stock?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=ai_stock_super_secret_jwt_key_mphasis_2026_change_in_prod
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL for CORS whitelisting
CLIENT_URL=http://localhost:5173

# ─── File Storage ────────────────────────────────────────────────────────────
# Options: "local" (default, zero config) or "cloudinary" (requires credentials below)
STORAGE_MODE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Cloudinary (optional - only needed if STORAGE_MODE=cloudinary) ──────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Gemini (chatbot AI) ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Alpha Vantage (real-time stock prices) ──────────────────────────────────
ALPHA_VANTAGE_KEY=IJ4ETO9O1UDEJPEK

# ─── ML Microservice (FastAPI XGBoost) ───────────────────────────────────────
# Local: http://localhost:8000  |  Deployed: https://your-ml-service.onrender.com
ML_SERVICE_URL=http://localhost:8000

# ─── Nodemailer (email alerts) ───────────────────────────────────────────────
# Setup: Enable 2FA on Gmail → Create App Password → paste below
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_TO=your_gmail@gmail.com
